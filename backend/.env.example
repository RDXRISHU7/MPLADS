# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/mplad_sentinel
# For Railway/Render deployment, replace with your actual database URL
# DATABASE_URL=postgresql://user:password@host:port/database

# Application Settings
APP_NAME=MPLAD Sentinel API
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-vercel-app.vercel.app

# Server
HOST=0.0.0.0
PORT=8000
